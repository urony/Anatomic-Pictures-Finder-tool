{
  "name": "anatomy-exam-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "כלי חינמי למורים: חיפוש תמונות אנטומיות ממאגרים פתוחים, סימון מספרים והפקת דף מבחן (PDF / Word)",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/build-library.mjs",
    "predev": "node scripts/build-library.mjs",
    "build:library": "node scripts/build-library.mjs",
    "build": "tsc --noEmit && vite build && node scripts/prune-dist-library.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:terms": "node scripts/build-terms.mjs"
  },
  "dependencies": {
    "docx": "^9.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jszip": "^3.10.1",
    "sharp": "^0.35.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
